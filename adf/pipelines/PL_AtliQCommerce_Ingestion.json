{
    "name": "PL_AtliQCommerce_Ingestion",
    "properties": {
        "activities": [
            {
                "name": "Lookup_ETL_Control_Table",
                "type": "Lookup",
                "dependsOn": [
                    {
                        "activity": "Set_Run_Start_At",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "AzureSqlSource",
                        "sqlReaderQuery": "SELECT\n    source_schema,\n    table_name,\n    load_type,\n    watermark_column,\n    last_loaded_at\nFROM etl.control_table;",
                        "queryTimeout": "02:00:00",
                        "partitionOption": "None"
                    },
                    "dataset": {
                        "referenceName": "DS_SQL_ETL_Control_Table",
                        "type": "DatasetReference"
                    },
                    "firstRowOnly": false
                }
            },
            {
                "name": "ForEach_Control_Table",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "Lookup_ETL_Control_Table",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@activity('Lookup_ETL_Control_Table').output.value",
                        "type": "Expression"
                    },
                    "isSequential": true,
                    "activities": [
                        {
                            "name": "If_Load_Type",
                            "type": "IfCondition",
                            "dependsOn": [],
                            "userProperties": [],
                            "typeProperties": {
                                "expression": {
                                    "value": "@equals(item().load_type, 'incremental')",
                                    "type": "Expression"
                                },
                                "ifFalseActivities": [
                                    {
                                        "name": "Copy_Full_SQL_to_Bronze",
                                        "type": "Copy",
                                        "dependsOn": [
                                            {
                                                "activity": "Delete_Full_Load_Bronze_Folder",
                                                "dependencyConditions": [
                                                    "Succeeded"
                                                ]
                                            }
                                        ],
                                        "policy": {
                                            "timeout": "0.12:00:00",
                                            "retry": 0,
                                            "retryIntervalInSeconds": 30,
                                            "secureOutput": false,
                                            "secureInput": false
                                        },
                                        "userProperties": [],
                                        "typeProperties": {
                                            "source": {
                                                "type": "AzureSqlSource",
                                                "sqlReaderQuery": {
                                                    "value": "@concat(\n  'SELECT * FROM [',\n  item().source_schema,\n  '].[', item().table_name, ']'\n)",
                                                    "type": "Expression"
                                                },
                                                "queryTimeout": "02:00:00",
                                                "partitionOption": "None"
                                            },
                                            "sink": {
                                                "type": "ParquetSink",
                                                "storeSettings": {
                                                    "type": "AzureBlobFSWriteSettings"
                                                },
                                                "formatSettings": {
                                                    "type": "ParquetWriteSettings"
                                                }
                                            },
                                            "enableStaging": false,
                                            "translator": {
                                                "type": "TabularTranslator",
                                                "typeConversion": true,
                                                "typeConversionSettings": {
                                                    "allowDataTruncation": true,
                                                    "treatBooleanAsNumber": false
                                                }
                                            }
                                        },
                                        "inputs": [
                                            {
                                                "referenceName": "DS_SQL_Source",
                                                "type": "DatasetReference",
                                                "parameters": {
                                                    "schema": {
                                                        "value": "@item().source_schema",
                                                        "type": "Expression"
                                                    },
                                                    "table": {
                                                        "value": "@item().table_name",
                                                        "type": "Expression"
                                                    }
                                                }
                                            }
                                        ],
                                        "outputs": [
                                            {
                                                "referenceName": "DS_ADLS_Bronze_Parquet",
                                                "type": "DatasetReference",
                                                "parameters": {
                                                    "file_system": "lakehouse",
                                                    "folder_path": {
                                                        "value": "@concat('bronze/', item().table_name)",
                                                        "type": "Expression"
                                                    }
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "name": "Update_Watermark_Full",
                                        "type": "SqlServerStoredProcedure",
                                        "dependsOn": [
                                            {
                                                "activity": "Copy_Full_SQL_to_Bronze",
                                                "dependencyConditions": [
                                                    "Succeeded"
                                                ]
                                            }
                                        ],
                                        "policy": {
                                            "timeout": "0.12:00:00",
                                            "retry": 0,
                                            "retryIntervalInSeconds": 30,
                                            "secureOutput": false,
                                            "secureInput": false
                                        },
                                        "userProperties": [],
                                        "typeProperties": {
                                            "storedProcedureName": "[etl].[usp_update_watermark]",
                                            "storedProcedureParameters": {
                                                "run_start_at": {
                                                    "value": {
                                                        "value": "@variables('run_start_at')",
                                                        "type": "Expression"
                                                    },
                                                    "type": "DateTime"
                                                },
                                                "table_name": {
                                                    "value": {
                                                        "value": "@item().table_name",
                                                        "type": "Expression"
                                                    },
                                                    "type": "String"
                                                }
                                            }
                                        },
                                        "linkedServiceName": {
                                            "referenceName": "LS_Azuresql_atliqcommerce",
                                            "type": "LinkedServiceReference"
                                        }
                                    },
                                    {
                                        "name": "Delete_Full_Load_Bronze_Folder",
                                        "type": "Delete",
                                        "dependsOn": [],
                                        "policy": {
                                            "timeout": "0.12:00:00",
                                            "retry": 0,
                                            "retryIntervalInSeconds": 30,
                                            "secureOutput": false,
                                            "secureInput": false
                                        },
                                        "userProperties": [],
                                        "typeProperties": {
                                            "dataset": {
                                                "referenceName": "DS_ADLS_Clickstream_Binary",
                                                "type": "DatasetReference",
                                                "parameters": {
                                                    "folder_path": {
                                                        "value": "@concat('bronze/', item().table_name)",
                                                        "type": "Expression"
                                                    }
                                                }
                                            },
                                            "enableLogging": false,
                                            "storeSettings": {
                                                "type": "AzureBlobFSReadSettings",
                                                "recursive": true,
                                                "enablePartitionDiscovery": false
                                            }
                                        }
                                    }
                                ],
                                "ifTrueActivities": [
                                    {
                                        "name": "Copy_Incremental_SQL_to_Bronze",
                                        "type": "Copy",
                                        "dependsOn": [
                                            {
                                                "activity": "Delete_Incremental_Bronze_Folder",
                                                "dependencyConditions": [
                                                    "Succeeded"
                                                ]
                                            }
                                        ],
                                        "policy": {
                                            "timeout": "0.12:00:00",
                                            "retry": 0,
                                            "retryIntervalInSeconds": 30,
                                            "secureOutput": false,
                                            "secureInput": false
                                        },
                                        "userProperties": [],
                                        "typeProperties": {
                                            "source": {
                                                "type": "AzureSqlSource",
                                                "sqlReaderQuery": {
                                                    "value": "@concat(\n  'SELECT * FROM [', item().source_schema, '].[', item().table_name,\n  '] WHERE [', item().watermark_column, '] > ''',\n  item().last_loaded_at, ''''\n)",
                                                    "type": "Expression"
                                                },
                                                "queryTimeout": "02:00:00",
                                                "partitionOption": "None"
                                            },
                                            "sink": {
                                                "type": "ParquetSink",
                                                "storeSettings": {
                                                    "type": "AzureBlobFSWriteSettings"
                                                },
                                                "formatSettings": {
                                                    "type": "ParquetWriteSettings"
                                                }
                                            },
                                            "enableStaging": false,
                                            "translator": {
                                                "type": "TabularTranslator",
                                                "typeConversion": true,
                                                "typeConversionSettings": {
                                                    "allowDataTruncation": true,
                                                    "treatBooleanAsNumber": false
                                                }
                                            }
                                        },
                                        "inputs": [
                                            {
                                                "referenceName": "DS_SQL_Source",
                                                "type": "DatasetReference",
                                                "parameters": {
                                                    "schema": {
                                                        "value": "@item().source_schema",
                                                        "type": "Expression"
                                                    },
                                                    "table": {
                                                        "value": "@item().table_name",
                                                        "type": "Expression"
                                                    }
                                                }
                                            }
                                        ],
                                        "outputs": [
                                            {
                                                "referenceName": "DS_ADLS_Bronze_Parquet",
                                                "type": "DatasetReference",
                                                "parameters": {
                                                    "file_system": "lakehouse",
                                                    "folder_path": {
                                                        "value": "@concat(\n  'bronze/', item().table_name,\n  '/ingest_date=',\n  formatDateTime(variables('run_start_at'), 'yyyy-MM-dd')\n)",
                                                        "type": "Expression"
                                                    }
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "name": "Update_Watermark_Incremental",
                                        "type": "SqlServerStoredProcedure",
                                        "dependsOn": [
                                            {
                                                "activity": "Copy_Incremental_SQL_to_Bronze",
                                                "dependencyConditions": [
                                                    "Succeeded"
                                                ]
                                            }
                                        ],
                                        "policy": {
                                            "timeout": "0.12:00:00",
                                            "retry": 0,
                                            "retryIntervalInSeconds": 30,
                                            "secureOutput": false,
                                            "secureInput": false
                                        },
                                        "userProperties": [],
                                        "typeProperties": {
                                            "storedProcedureName": "[etl].[usp_update_watermark]",
                                            "storedProcedureParameters": {
                                                "run_start_at": {
                                                    "value": {
                                                        "value": "@variables('run_start_at')",
                                                        "type": "Expression"
                                                    },
                                                    "type": "DateTime"
                                                },
                                                "table_name": {
                                                    "value": {
                                                        "value": "@item().table_name",
                                                        "type": "Expression"
                                                    },
                                                    "type": "String"
                                                }
                                            }
                                        },
                                        "linkedServiceName": {
                                            "referenceName": "LS_Azuresql_atliqcommerce",
                                            "type": "LinkedServiceReference"
                                        }
                                    },
                                    {
                                        "name": "Delete_Incremental_Bronze_Folder",
                                        "type": "Delete",
                                        "dependsOn": [],
                                        "policy": {
                                            "timeout": "0.12:00:00",
                                            "retry": 0,
                                            "retryIntervalInSeconds": 30,
                                            "secureOutput": false,
                                            "secureInput": false
                                        },
                                        "userProperties": [],
                                        "typeProperties": {
                                            "dataset": {
                                                "referenceName": "DS_ADLS_Clickstream_Binary",
                                                "type": "DatasetReference",
                                                "parameters": {
                                                    "folder_path": {
                                                        "value": "@concat(\n    'bronze/', item().table_name,\n    '/ingest_date=',\n    formatDateTime(variables('run_start_at'), 'yyyy-MM-dd')\n)",
                                                        "type": "Expression"
                                                    }
                                                }
                                            },
                                            "enableLogging": false,
                                            "storeSettings": {
                                                "type": "AzureBlobFSReadSettings",
                                                "recursive": true,
                                                "enablePartitionDiscovery": false
                                            }
                                        }
                                    }
                                ]
                            }
                        }
                    ]
                }
            },
            {
                "name": "Set_Run_Start_At",
                "type": "SetVariable",
                "dependsOn": [],
                "policy": {
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "variableName": "run_start_at",
                    "value": {
                        "value": "@utcnow()",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "Get_CSV_Files",
                "type": "GetMetadata",
                "dependsOn": [
                    {
                        "activity": "Set_Run_Start_At",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "dataset": {
                        "referenceName": "LS_ADLS_atliqcommerce",
                        "type": "DatasetReference"
                    },
                    "fieldList": [
                        "childItems"
                    ],
                    "storeSettings": {
                        "type": "AzureBlobFSReadSettings",
                        "recursive": true,
                        "enablePartitionDiscovery": false
                    },
                    "formatSettings": {
                        "type": "BinaryReadSettings"
                    }
                }
            },
            {
                "name": "Filter_CSV_Files",
                "type": "Filter",
                "dependsOn": [
                    {
                        "activity": "Get_CSV_Files",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@activity('Get_CSV_Files').output.childItems",
                        "type": "Expression"
                    },
                    "condition": {
                        "value": "@endsWith(item().name, '.csv')",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "ForEach_CSV_File",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "Filter_CSV_Files",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@activity('Filter_CSV_Files').output.value",
                        "type": "Expression"
                    },
                    "isSequential": true,
                    "activities": [
                        {
                            "name": "Copy_CSV_to_Bronze",
                            "type": "Copy",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "DelimitedTextSource",
                                    "storeSettings": {
                                        "type": "AzureBlobFSReadSettings",
                                        "recursive": true,
                                        "enablePartitionDiscovery": false
                                    },
                                    "formatSettings": {
                                        "type": "DelimitedTextReadSettings"
                                    }
                                },
                                "sink": {
                                    "type": "ParquetSink",
                                    "storeSettings": {
                                        "type": "AzureBlobFSWriteSettings",
                                        "copyBehavior": "FlattenHierarchy"
                                    },
                                    "formatSettings": {
                                        "type": "ParquetWriteSettings"
                                    }
                                },
                                "enableStaging": false,
                                "translator": {
                                    "type": "TabularTranslator",
                                    "typeConversion": true,
                                    "typeConversionSettings": {
                                        "allowDataTruncation": true,
                                        "treatBooleanAsNumber": false
                                    }
                                }
                            },
                            "inputs": [
                                {
                                    "referenceName": "DS_adls_bronze_sink",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "folder_path": "landing/csv",
                                        "file_name": {
                                            "value": "@item().name",
                                            "type": "Expression"
                                        },
                                        "file_system": "lakehouse"
                                    }
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "DS_ADLS_Bronze_Parquet",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "file_system": "lakehouse",
                                        "folder_path": {
                                            "value": "@concat('bronze/', replace(item().name, '.csv', ''))",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ]
                        }
                    ]
                }
            },
            {
                "name": "Copy_Clickstream_to_Bronze",
                "type": "Copy",
                "dependsOn": [
                    {
                        "activity": "Set_Run_Start_At",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "BinarySource",
                        "storeSettings": {
                            "type": "AzureBlobFSReadSettings",
                            "recursive": true,
                            "wildcardFolderPath": "landing/clickstream",
                            "wildcardFileName": "*.json",
                            "deleteFilesAfterCompletion": false
                        },
                        "formatSettings": {
                            "type": "BinaryReadSettings"
                        }
                    },
                    "sink": {
                        "type": "BinarySink",
                        "storeSettings": {
                            "type": "AzureBlobFSWriteSettings",
                            "copyBehavior": "PreserveHierarchy"
                        }
                    },
                    "enableStaging": false
                },
                "inputs": [
                    {
                        "referenceName": "DS_ADLS_Clickstream_Binary",
                        "type": "DatasetReference",
                        "parameters": {
                            "folder_path": "landing/clickstream"
                        }
                    }
                ],
                "outputs": [
                    {
                        "referenceName": "DS_ADLS_Clickstream_Binary",
                        "type": "DatasetReference",
                        "parameters": {
                            "folder_path": "bronze/clickstream"
                        }
                    }
                ]
            }
        ],
        "variables": {
            "run_start_at": {
                "type": "String"
            }
        },
        "annotations": [],
        "lastPublishTime": "2026-11-06T13:46:34Z"
    },
    "type": "Microsoft.DataFactory/factories/pipelines"
}
